{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UVTT v2 Interactive Entities Schema (entities.schema.json)",
  "description": "JSON Schema validating interactive layers in Universal VTT v2 including lights, landing zones, events, ambient audio zones, and atmospheric weather/particle emitters.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format_version": {
      "type": "string",
      "enum": [
        "2.0.0"
      ]
    },
    "lights": {
      "type": "array",
      "description": "An array of dynamic 3D-aware light sources.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "position",
          "color",
          "bright_radius",
          "dim_radius",
          "decay"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier for this light source."
          },
          "type": {
            "type": "string",
            "enum": [
              "point",
              "directional"
            ],
            "description": "Point casts light 360 degrees. Directional limits illumination to a sector cone."
          },
          "position": {
            "type": "object",
            "required": [
              "x",
              "y",
              "z"
            ],
            "additionalProperties": false,
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "z": {
                "type": "number",
                "description": "3D height position of the light source relative to the floor plane."
              }
            }
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$",
            "description": "6-character hex code (#RRGGBB) or 8-character hex code with alpha (#RRGGBBAA)."
          },
          "bright_radius": {
            "type": "number",
            "minimum": 0.0,
            "description": "Radius of bright light in physical units (e.g. feet/meters)."
          },
          "dim_radius": {
            "type": "number",
            "minimum": 0.0,
            "description": "Total radius of illumination (dim light begins where bright light ends)."
          },
          "decay": {
            "type": "string",
            "enum": [
              "linear",
              "inverse_square"
            ],
            "description": "Mathematical decay model. Inverse-square models physical light attenuation."
          },
          "cone": {
            "type": "object",
            "required": [
              "rotation",
              "arc"
            ],
            "additionalProperties": false,
            "properties": {
              "rotation": {
                "type": "number",
                "minimum": 0.0,
                "maximum": 360.0,
                "description": "The center direction of the cone beam in degrees."
              },
              "arc": {
                "type": "number",
                "minimum": 1.0,
                "maximum": 360.0,
                "description": "The angular width of the beam in degrees (e.g. 60.0 for a bullseye lantern)."
              }
            }
          },
          "animation": {
            "type": "object",
            "required": [
              "type",
              "speed",
              "intensity_variance"
            ],
            "additionalProperties": false,
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "flicker",
                  "pulse"
                ]
              },
              "speed": {
                "type": "number",
                "minimum": 0.0
              },
              "intensity_variance": {
                "type": "number",
                "minimum": 0.0,
                "maximum": 1.0,
                "description": "Flicker/pulse depth ratio (0.0 = static, 1.0 = full amplitude)."
              }
            }
          },
          "visibility": {
            "type": "string",
            "enum": [
              "visible",
              "gm_only",
              "hidden"
            ]
          },
          "sync_id": {
            "type": "string"
          }
        }
      }
    },
    "landing_zones": {
      "type": "array",
      "description": "Explicit player token starting positions or camera anchors.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "is_default",
          "coordinates",
          "heading_degrees"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "is_default": {
            "type": "boolean",
            "description": "If true, this is the main starting zone. Exactly one is_default=true is permitted per map."
          },
          "coordinates": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number"
            },
            "description": "[X, Y] absolute coordinate array of the landing zone."
          },
          "heading_degrees": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 360.0,
            "description": "Compass direction players face upon arrival."
          },
          "properties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "description": {
                "type": "string"
              },
              "camera_zoom_level": {
                "type": "number",
                "minimum": 0.1
              }
            }
          },
          "visibility": {
            "type": "string",
            "enum": [
              "visible",
              "gm_only",
              "hidden"
            ]
          },
          "sync_id": {
            "type": "string"
          }
        }
      }
    },
    "events": {
      "type": "array",
      "description": "Interactive triggers such as traps, teleporters, stairs, or pitfalls.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "trigger_bounds"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "teleport",
              "trap"
            ]
          },
          "trigger_bounds": {
            "type": "object",
            "required": [
              "shape"
            ],
            "additionalProperties": false,
            "properties": {
              "shape": {
                "type": "string",
                "enum": [
                  "polygon",
                  "circle"
                ]
              },
              "points": {
                "type": "array",
                "minItems": 3,
                "items": {
                  "type": "object",
                  "required": [
                    "x",
                    "y"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    }
                  }
                }
              },
              "center": {
                "type": "object",
                "required": [
                  "x",
                  "y"
                ],
                "additionalProperties": false,
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  }
                }
              },
              "radius": {
                "type": "number",
                "minimum": 0.0
              }
            }
          },
          "conditions": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "requires_interaction": {
                "type": "boolean"
              },
              "interaction_key": {
                "type": "string"
              },
              "allowed_modes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "is_active": {
                "type": "boolean"
              },
              "key_item_required": {
                "type": "string"
              }
            }
          },
          "destination": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "intra_map",
                  "inter_map"
                ]
              },
              "uri": {
                "type": "string",
                "description": "Standardized URI target: internal://{map_slug} or relative://{package_file}."
              },
              "fade_transition": {
                "type": "string",
                "enum": [
                  "crossfade_black",
                  "planar_flash"
                ]
              },
              "prediction_trigger_radius": {
                "type": "number",
                "minimum": 0.0,
                "description": "Proximity radius in grid units to pre-fetch target assets before transition executes."
              }
            }
          },
          "visibility": {
            "type": "string",
            "enum": [
              "visible",
              "gm_only",
              "hidden"
            ]
          },
          "sync_id": {
            "type": "string"
          },
          "portal_dependency": {
            "type": "object",
            "required": [
              "portal_id",
              "allowed_states"
            ],
            "additionalProperties": false,
            "properties": {
              "portal_id": {
                "type": "string"
              },
              "allowed_states": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "open",
                    "closed",
                    "locked",
                    "broken"
                  ]
                }
              },
              "lock_feedback_message": {
                "type": "string"
              }
            }
          },
          "actions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "target_id",
                "action_type",
                "property",
                "value"
              ],
              "additionalProperties": false,
              "properties": {
                "target_id": {
                  "type": "string"
                },
                "action_type": {
                  "type": "string",
                  "enum": [
                    "set_property",
                    "play_sound",
                    "trigger_event"
                  ]
                },
                "property": {
                  "type": "string"
                },
                "value": {
                  "type": [
                    "string",
                    "number",
                    "boolean"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "audio": {
      "type": "object",
      "required": [
        "zones"
      ],
      "additionalProperties": false,
      "properties": {
        "zones": {
          "type": "array",
          "description": "Localized, proximity-based acoustic zones.",
          "items": {
            "type": "object",
            "required": [
              "id",
              "shape",
              "fade_radius",
              "volume_max",
              "audio_uri"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "shape": {
                "type": "string",
                "enum": [
                  "circle",
                  "polygon"
                ]
              },
              "center": {
                "type": "object",
                "required": [
                  "x",
                  "y"
                ],
                "additionalProperties": false,
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  }
                }
              },
              "radius": {
                "type": "number",
                "minimum": 0.0
              },
              "points": {
                "type": "array",
                "minItems": 3,
                "items": {
                  "type": "object",
                  "required": [
                    "x",
                    "y"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    }
                  }
                }
              },
              "fade_radius": {
                "type": "number",
                "minimum": 0.0,
                "description": "Buffer distance beyond boundary where linear falloff attenuation begins."
              },
              "volume_max": {
                "type": "number",
                "minimum": 0.0,
                "maximum": 1.0,
                "description": "Maximum playback volume at or inside boundaries."
              },
              "audio_uri": {
                "type": "string",
                "description": "Local URI reference inside assets/ subdirectory."
              },
              "visibility": {
                "type": "string",
                "enum": [
                  "visible",
                  "gm_only",
                  "hidden"
                ]
              },
              "sync_id": {
                "type": "string"
              },
              "muffled_by_geometry": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "emitters": {
      "type": "array",
      "description": "Atmospheric weather or magic particle emitter zones.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "properties"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier for this particle emitter."
          },
          "type": {
            "type": "string",
            "enum": [
              "rain",
              "snow",
              "fog",
              "embers",
              "magic"
            ],
            "description": "Particle type preset. Drives shaders and physics parameters."
          },
          "bounds": {
            "type": "object",
            "required": [
              "shape"
            ],
            "additionalProperties": false,
            "properties": {
              "shape": {
                "type": "string",
                "enum": [
                  "polygon",
                  "circle"
                ]
              },
              "points": {
                "type": "array",
                "minItems": 3,
                "items": {
                  "type": "object",
                  "required": [
                    "x",
                    "y"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    }
                  }
                }
              },
              "center": {
                "type": "object",
                "required": [
                  "x",
                  "y"
                ],
                "additionalProperties": false,
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  }
                }
              },
              "radius": {
                "type": "number",
                "minimum": 0.0
              }
            }
          },
          "properties": {
            "type": "object",
            "required": [
              "intensity",
              "speed",
              "angle",
              "color"
            ],
            "additionalProperties": false,
            "properties": {
              "intensity": {
                "type": "number",
                "minimum": 0.0,
                "maximum": 1.0,
                "description": "Scale of particle density/emission rates."
              },
              "speed": {
                "type": "number",
                "minimum": 0.0,
                "description": "Velocity scale of particles."
              },
              "angle": {
                "type": "number",
                "minimum": 0.0,
                "maximum": 360.0,
                "description": "Drift direction in degrees (0.0 = straight down, 90.0 = blowing right)."
              },
              "color": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$",
                "description": "6-character hexadecimal color tint overlay (#RRGGBB)."
              },
              "render_layer": {
                "type": "string",
                "enum": [
                  "above_overhead",
                  "below_overhead",
                  "ground_level"
                ]
              },
              "collision_mode": {
                "type": "string",
                "enum": [
                  "none",
                  "mask_under_overhead",
                  "ground_terminate",
                  "wall_bounce"
                ]
              },
              "wind_influence": {
                "type": "object",
                "required": [
                  "inherit_global",
                  "influence_scale"
                ],
                "additionalProperties": false,
                "properties": {
                  "inherit_global": {
                    "type": "boolean"
                  },
                  "influence_scale": {
                    "type": "number",
                    "minimum": 0.0,
                    "maximum": 2.0
                  }
                }
              }
            }
          },
          "visibility": {
            "type": "string",
            "enum": [
              "visible",
              "gm_only",
              "hidden"
            ]
          },
          "sync_id": {
            "type": "string"
          },
          "is_global": {
            "type": "boolean"
          },
          "height": {
            "type": "object",
            "required": [
              "bottom",
              "top"
            ],
            "additionalProperties": false,
            "properties": {
              "bottom": {
                "type": "number"
              },
              "top": {
                "type": "number"
              }
            }
          }
        }
      }
    }
  }
}