{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UVTT v2 Entities Schema",
  "description": "Defines interactive components including 3D lighting, landing zones, teleportation scripts, weather systems, and 3-tier audio layers.",
  "type": "object",
  "properties": {
    "lights": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "position",
          "color",
          "bright_radius",
          "dim_radius",
          "decay"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "point",
              "directional"
            ]
          },
          "position": {
            "type": "object",
            "required": [
              "x",
              "y",
              "z"
            ],
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "z": {
                "type": "number"
              }
            }
          },
          "color": {
            "type": "string",
            "pattern": "^#[a-fA-F0-9]{6}$"
          },
          "bright_radius": {
            "type": "number"
          },
          "dim_radius": {
            "type": "number"
          },
          "decay": {
            "type": "string",
            "enum": [
              "linear",
              "inverse_square"
            ]
          },
          "cone": {
            "type": "object",
            "required": [
              "rotation",
              "arc"
            ],
            "properties": {
              "rotation": {
                "type": "number"
              },
              "arc": {
                "type": "number"
              }
            }
          },
          "animation": {
            "type": "object",
            "required": [
              "type",
              "speed",
              "intensity_variance"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "flicker",
                  "pulse"
                ]
              },
              "speed": {
                "type": "number"
              },
              "intensity_variance": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "landing_zones": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "is_default",
          "coordinates",
          "heading_degrees"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "is_default": {
            "type": "boolean"
          },
          "coordinates": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number"
            }
          },
          "heading_degrees": {
            "type": "number"
          },
          "properties": {
            "type": "object",
            "properties": {
              "description": {
                "type": "string"
              },
              "camera_zoom_level": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "trigger_bounds",
          "conditions",
          "destination"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "teleport",
              "trap"
            ]
          },
          "trigger_bounds": {
            "type": "object",
            "required": [
              "shape"
            ],
            "properties": {
              "shape": {
                "type": "string",
                "enum": [
                  "polygon",
                  "circle"
                ]
              },
              "points": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "x",
                    "y"
                  ],
                  "properties": {
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    }
                  }
                }
              },
              "center": {
                "type": "object",
                "required": [
                  "x",
                  "y"
                ],
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  }
                }
              },
              "radius": {
                "type": "number"
              }
            }
          },
          "conditions": {
            "type": "object",
            "properties": {
              "requires_interaction": {
                "type": "boolean"
              },
              "interaction_key": {
                "type": "string"
              },
              "allowed_modes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "is_active": {
                "type": "boolean"
              },
              "key_item_required": {
                "type": "string"
              }
            }
          },
          "destination": {
            "type": "object",
            "required": [
              "type",
              "uri"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "intra_map",
                  "inter_map"
                ]
              },
              "uri": {
                "type": "string",
                "description": "Unified URI using internal:// (compound) or relative:// (federated) routing targets."
              },
              "fade_transition": {
                "type": "string",
                "enum": [
                  "crossfade_black",
                  "planar_flash"
                ]
              },
              "prediction_trigger_radius": {
                "type": "number",
                "description": "Trigger buffer threshold in grids to pre-slice tiles."
              }
            }
          },
          "portal_dependency": {
            "type": "object",
            "description": "Optional dependency on a physical portal state (e.g., a door or trapdoor) to enable/gate this event.",
            "required": [
              "portal_id",
              "allowed_states"
            ],
            "properties": {
              "portal_id": {
                "type": "string",
                "description": "The unique ID of the target portal from geometry.json."
              },
              "allowed_states": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "open",
                    "closed",
                    "broken",
                    "locked"
                  ]
                },
                "description": "The list of portal states that allow this trigger to fire."
              },
              "lock_feedback_message": {
                "type": "string",
                "description": "The message displayed to GMs or players if they attempt to trigger this event while the portal is closed."
              }
            }
          }
        }
      }
    },
    "audio": {
      "type": "object",
      "properties": {
        "music": {
          "type": "object",
          "required": [
            "uri",
            "volume"
          ],
          "properties": {
            "uri": {
              "type": "string"
            },
            "volume": {
              "type": "number",
              "minimum": 0.0,
              "maximum": 1.0
            },
            "crossfade_duration": {
              "type": "number"
            }
          }
        },
        "ambience": {
          "type": "object",
          "required": [
            "uri",
            "volume"
          ],
          "properties": {
            "uri": {
              "type": "string"
            },
            "volume": {
              "type": "number",
              "minimum": 0.0,
              "maximum": 1.0
            }
          }
        },
        "zones": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "shape",
              "radius",
              "fade_radius",
              "volume_max",
              "audio_uri"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "shape": {
                "type": "string",
                "enum": [
                  "circle",
                  "polygon"
                ]
              },
              "center": {
                "type": "object",
                "required": [
                  "x",
                  "y"
                ],
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  }
                }
              },
              "radius": {
                "type": "number"
              },
              "fade_radius": {
                "type": "number"
              },
              "volume_max": {
                "type": "number",
                "minimum": 0.0,
                "maximum": 1.0
              },
              "audio_uri": {
                "type": "string"
              },
              "muffled_by_geometry": {
                "type": "boolean",
                "description": "If true, the VTT applies acoustic raycasting to muffle sound through walls and portals."
              }
            }
          }
        }
      }
    },
    "emitters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "properties"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "rain",
              "snow",
              "fog",
              "embers",
              "magic"
            ]
          },
          "is_global": {
            "type": "boolean",
            "description": "If true, the emitter affects the entire map and the bounds parameter is optional."
          },
          "bounds": {
            "type": "object",
            "required": [
              "shape"
            ],
            "properties": {
              "shape": {
                "type": "string",
                "enum": [
                  "polygon",
                  "circle"
                ]
              },
              "points": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "x",
                    "y"
                  ],
                  "properties": {
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    }
                  }
                }
              }
            }
          },
          "properties": {
            "type": "object",
            "required": [
              "intensity",
              "speed",
              "angle",
              "color"
            ],
            "properties": {
              "intensity": {
                "type": "number",
                "minimum": 0.0,
                "maximum": 1.0
              },
              "speed": {
                "type": "number"
              },
              "angle": {
                "type": "number"
              },
              "color": {
                "type": "string",
                "pattern": "^#[a-fA-F0-9]{6}$"
              },
              "render_layer": {
                "type": "string",
                "enum": [
                  "above_overhead",
                  "below_overhead",
                  "ground_level"
                ],
                "description": "Governs where particles sit in the visual Z-index rendering stack."
              }
            }
          }
        }
      }
    }
  }
}