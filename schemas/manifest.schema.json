{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://universalvtt.org/schemas/v2/entities.schema.json",
  "title": "UVTT v2 Interactive Entities Schema",
  "description": "JSON Schema validating interactive layers in Universal VTT v2 including lights, landing zones, events, ambient audio zones, global audio, and atmospheric weather/particle emitters.",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "map_origin": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "additionalProperties": false
    },
    "global_audio_item": {
      "type": "object",
      "properties": {
        "uri": {
          "type": "string"
        },
        "volume": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "crossfade_duration": {
          "type": "number",
          "minimum": 0.0
        }
      },
      "required": [
        "uri",
        "volume"
      ],
      "additionalProperties": false
    }
  },
  "properties": {
    "format_version": {
      "type": "string",
      "const": "2.0.0"
    },
    "lights": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "point",
              "directional"
            ]
          },
          "position": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "z": {
                "type": "number"
              }
            },
            "required": [
              "x",
              "y",
              "z"
            ],
            "additionalProperties": false
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"
          },
          "bright_radius": {
            "type": "number",
            "minimum": 0.0
          },
          "dim_radius": {
            "type": "number",
            "minimum": 0.0
          },
          "decay": {
            "type": "string",
            "enum": [
              "linear",
              "inverse_square"
            ]
          },
          "cone": {
            "type": "object",
            "properties": {
              "rotation": {
                "type": "number",
                "minimum": 0.0,
                "maximum": 360.0
              },
              "arc": {
                "type": "number",
                "minimum": 1.0,
                "maximum": 360.0
              }
            },
            "required": [
              "rotation",
              "arc"
            ],
            "additionalProperties": false
          },
          "animation": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "flicker",
                  "pulse"
                ]
              },
              "speed": {
                "type": "number",
                "minimum": 0.0
              },
              "intensity_variance": {
                "type": "number",
                "minimum": 0.0,
                "maximum": 1.0
              }
            },
            "required": [
              "type",
              "speed",
              "intensity_variance"
            ],
            "additionalProperties": false
          },
          "visibility": {
            "type": "string",
            "enum": [
              "visible",
              "gm_only",
              "hidden"
            ]
          },
          "sync_id": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "type",
          "position",
          "color",
          "bright_radius",
          "dim_radius",
          "decay"
        ],
        "additionalProperties": false
      }
    },
    "landing_zones": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "is_default": {
            "type": "boolean"
          },
          "coordinates": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number"
            }
          },
          "heading_degrees": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 360.0
          },
          "properties": {
            "type": "object",
            "properties": {
              "description": {
                "type": "string"
              },
              "camera_zoom_level": {
                "type": "number",
                "minimum": 0.1
              }
            },
            "additionalProperties": false
          },
          "visibility": {
            "type": "string",
            "enum": [
              "visible",
              "gm_only",
              "hidden"
            ]
          },
          "sync_id": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "is_default",
          "coordinates",
          "heading_degrees"
        ],
        "additionalProperties": false
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "teleport",
              "trap",
              "trigger"
            ]
          },
          "trigger_bounds": {
            "type": "object",
            "properties": {
              "shape": {
                "type": "string",
                "enum": [
                  "polygon",
                  "circle"
                ]
              },
              "points": {
                "type": "array",
                "minItems": 3,
                "items": {
                  "$ref": "#/definitions/map_origin"
                }
              },
              "center": {
                "$ref": "#/definitions/map_origin"
              },
              "radius": {
                "type": "number",
                "minimum": 0.0
              }
            },
            "required": [
              "shape"
            ],
            "additionalProperties": false
          },
          "conditions": {
            "type": "object",
            "properties": {
              "requires_interaction": {
                "type": "boolean"
              },
              "interaction_key": {
                "type": "string"
              },
              "allowed_modes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "is_active": {
                "type": "boolean"
              },
              "key_item_required": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "destination": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "intra_map",
                  "inter_map"
                ]
              },
              "uri": {
                "type": "string"
              },
              "fade_transition": {
                "type": "string",
                "enum": [
                  "crossfade_black",
                  "planar_flash"
                ]
              },
              "prediction_trigger_radius": {
                "type": "number",
                "minimum": 0.0
              }
            },
            "additionalProperties": false
          },
          "visibility": {
            "type": "string",
            "enum": [
              "visible",
              "gm_only",
              "hidden"
            ]
          },
          "sync_id": {
            "type": "string"
          },
          "portal_dependency": {
            "type": "object",
            "properties": {
              "portal_id": {
                "type": "string"
              },
              "allowed_states": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "open",
                    "closed",
                    "locked",
                    "broken"
                  ]
                }
              },
              "lock_feedback_message": {
                "type": "string"
              }
            },
            "required": [
              "portal_id",
              "allowed_states"
            ],
            "additionalProperties": false
          },
          "actions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "target_id": {
                  "type": "string"
                },
                "action_type": {
                  "type": "string",
                  "enum": [
                    "set_property",
                    "play_sound",
                    "trigger_event"
                  ]
                },
                "property": {
                  "type": "string"
                },
                "value": {
                  "type": [
                    "string",
                    "number",
                    "boolean"
                  ]
                }
              },
              "required": [
                "target_id",
                "action_type",
                "property",
                "value"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "type",
          "trigger_bounds"
        ],
        "additionalProperties": false
      }
    },
    "audio": {
      "type": "object",
      "properties": {
        "music": {
          "$ref": "#/definitions/global_audio_item"
        },
        "ambience": {
          "$ref": "#/definitions/global_audio_item"
        },
        "zones": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "shape": {
                "type": "string",
                "enum": [
                  "circle",
                  "polygon"
                ]
              },
              "center": {
                "$ref": "#/definitions/map_origin"
              },
              "radius": {
                "type": "number",
                "minimum": 0.0
              },
              "points": {
                "type": "array",
                "minItems": 3,
                "items": {
                  "$ref": "#/definitions/map_origin"
                }
              },
              "fade_radius": {
                "type": "number",
                "minimum": 0.0
              },
              "volume_max": {
                "type": "number",
                "minimum": 0.0,
                "maximum": 1.0
              },
              "audio_uri": {
                "type": "string"
              },
              "visibility": {
                "type": "string",
                "enum": [
                  "visible",
                  "gm_only",
                  "hidden"
                ]
              },
              "sync_id": {
                "type": "string"
              },
              "muffled_by_geometry": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "shape",
              "fade_radius",
              "volume_max",
              "audio_uri"
            ],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "emitters": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "rain",
              "snow",
              "fog",
              "embers",
              "magic"
            ]
          },
          "bounds": {
            "type": "object",
            "properties": {
              "shape": {
                "type": "string",
                "enum": [
                  "polygon",
                  "circle"
                ]
              },
              "points": {
                "type": "array",
                "minItems": 3,
                "items": {
                  "$ref": "#/definitions/map_origin"
                }
              },
              "center": {
                "$ref": "#/definitions/map_origin"
              },
              "radius": {
                "type": "number",
                "minimum": 0.0
              }
            },
            "required": [
              "shape"
            ],
            "additionalProperties": false
          },
          "properties": {
            "type": "object",
            "properties": {
              "intensity": {
                "type": "number",
                "minimum": 0.0,
                "maximum": 1.0
              },
              "speed": {
                "type": "number",
                "minimum": 0.0
              },
              "angle": {
                "type": "number",
                "minimum": 0.0,
                "maximum": 360.0
              },
              "color": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "render_layer": {
                "type": "string",
                "enum": [
                  "above_overhead",
                  "below_overhead",
                  "ground_level"
                ]
              },
              "collision_mode": {
                "type": "string",
                "enum": [
                  "none",
                  "mask_under_overhead",
                  "ground_terminate",
                  "wall_bounce"
                ]
              },
              "wind_influence": {
                "type": "object",
                "properties": {
                  "inherit_global": {
                    "type": "boolean"
                  },
                  "influence_scale": {
                    "type": "number",
                    "minimum": 0.0,
                    "maximum": 2.0
                  }
                },
                "required": [
                  "inherit_global",
                  "influence_scale"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "intensity",
              "speed",
              "angle",
              "color"
            ],
            "additionalProperties": false
          },
          "visibility": {
            "type": "string",
            "enum": [
              "visible",
              "gm_only",
              "hidden"
            ]
          },
          "sync_id": {
            "type": "string"
          },
          "is_global": {
            "type": "boolean"
          },
          "height": {
            "type": "object",
            "properties": {
              "bottom": {
                "type": "number"
              },
              "top": {
                "type": "number"
              }
            },
            "required": [
              "bottom",
              "top"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "type",
          "properties"
        ],
        "additionalProperties": false
      }
    }
  }
}