{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UVTT v2 Root Manifest Schema (manifest.schema.json)",
  "description": "Validation rules for the root manifest.json inside a UVTT v2 package (.uvtt2z).",
  "type": "object",
  "required": ["format_version", "uvtt_version", "campaign_name", "map_catalog"],
  "additionalProperties": false,
  "properties": {
    "format_version": {
      "type": "string",
      "enum": ["2.0.0"]
    },
    "uvtt_version": {
      "type": "string",
      "enum": ["2.0.0"]
    },
    "campaign_name": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "license": {
      "type": "string"
    },
    "hardware_profile": {
      "type": "object",
      "required": ["minimum_pipeline", "recommended_pipeline", "requires_compute_shaders"],
      "additionalProperties": false,
      "properties": {
        "minimum_pipeline": {
          "type": "string",
          "enum": ["webgl2", "webgpu"]
        },
        "recommended_pipeline": {
          "type": "string",
          "enum": ["webgl2", "webgpu"]
        },
        "requires_compute_shaders": {
          "type": "boolean"
        }
      }
    },
    "encryption_handshake": {
      "type": "object",
      "required": ["clearinghouse_url", "license_authority", "key_salt_checksum"],
      "additionalProperties": false,
      "properties": {
        "clearinghouse_url": {
          "type": "string",
          "format": "uri"
        },
        "license_authority": {
          "type": "string",
          "format": "uri"
        },
        "key_salt_checksum": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{32}$",
          "description": "32-character hex key salt checksum"
        }
      }
    },
    "environment": {
      "type": "object",
      "required": ["global_wind"],
      "additionalProperties": false,
      "properties": {
        "global_wind": {
          "type": "object",
          "required": ["speed", "angle", "gust_variance"],
          "additionalProperties": false,
          "properties": {
            "speed": {
              "type": "number",
              "minimum": 0.0
            },
            "angle": {
              "type": "number",
              "minimum": 0.0,
              "maximum": 360.0
            },
            "gust_variance": {
              "type": "number",
              "minimum": 0.0,
              "maximum": 1.0
            }
          }
        }
      }
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "music": {
          "type": "object",
          "required": ["uri", "volume"],
          "additionalProperties": false,
          "properties": {
            "uri": {
              "type": "string"
            },
            "volume": {
              "type": "number",
              "minimum": 0.0,
              "maximum": 1.0
            },
            "crossfade_duration": {
              "type": "number",
              "minimum": 0.0
            }
          }
        },
        "ambience": {
          "type": "object",
          "required": ["uri", "volume"],
          "additionalProperties": false,
          "properties": {
            "uri": {
              "type": "string"
            },
            "volume": {
              "type": "number",
              "minimum": 0.0,
              "maximum": 1.0
            }
          }
        }
      }
    },
    "map_catalog": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "slug", "path", "z_index"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "path": {
            "type": "string"
          },
          "z_index": {
            "type": "integer"
          }
        }
      }
    }
  }
}
